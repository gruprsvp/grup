# Store metadata is code: fastlane/metadata/{android,ios}/<locale>/ is the
# source of truth for both store listings. These lanes push it; nothing here
# uploads binaries (builds ship via build.yaml / Xcode Cloud).

opt_out_usage

platform :android do
  desc "Sync the Play Store listing (text, screenshots, graphics) from fastlane/metadata/android"
  lane :sync_metadata do
    # supply insists on resolving exactly one release even for metadata-only
    # syncs, so it fails whenever production holds both a completed release and
    # a draft (mid-promotion). Pinning version_code to the newest code in the
    # track keeps the resolution unambiguous.
    codes = google_play_track_version_codes(track: "production")
    upload_to_play_store(
      track: "production",
      version_code: codes.max,
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true, # release notes ride with each build upload in build.yaml
      # Checksum-based image sync: only changed images are re-uploaded,
      # removed ones are deleted — the store mirrors the repo.
      sync_image_upload: true,
    )
  end
end

platform :ios do
  desc "Sync the App Store listing (name, subtitle, description, keywords, release notes, screenshots) from fastlane/metadata/ios and fastlane/screenshots"
  lane :sync_metadata do
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_CONTENT"),
    )
    # Version-level metadata (release notes, promotional text) can only be
    # written to an editable ("Prepare for Submission") version. Without
    # app_version, deliver polls for one to appear and burns the job timeout
    # whenever ASC has none (e.g. the previous version just went into review).
    # Pinning the pubspec version makes deliver create the version if missing
    # and fail fast with a real error otherwise.
    pubspec_version = YAML.load_file("../pubspec.yaml")["version"].split("+").first
    # Checksum-based, like supply's sync_image_upload: only changed screenshots
    # are uploaded and the rest deleted, so the store mirrors the repo. Still a
    # beta in deliver, hence the opt-in variable.
    ENV["FASTLANE_ENABLE_BETA_DELIVER_SYNC_SCREENSHOTS"] = "true"
    upload_to_app_store(
      app_version: pubspec_version,
      metadata_path: "./fastlane/metadata/ios",
      skip_binary_upload: true,
      # Generated by test/store_screenshots/ (docs/STORE_SCREENSHOTS.md).
      screenshots_path: "./fastlane/screenshots",
      sync_screenshots: true,
      force: true,            # no interactive HTML preview in CI
      run_precheck_before_submit: false, # precheck needs Spaceship auth beyond the API key
    )
  end
end
